{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "mol_file",
      "type": "promptString",
      "description": "Ruta al .xyz de la molécula",
      "default": "molecules/mol_B.xyz"
    },
    {
      "id": "charge",
      "type": "promptString",
      "description": "Carga de la molécula",
      "default": "-1"
    },
    {
      "id": "mol_name",
      "type": "promptString",
      "description": "Nombre de la molécula (para el monitor; coincide con runs/<nombre>)",
      "default": "mol_B"
    },
    {
      "id": "start_step",
      "type": "pickString",
      "description": "Etapa de inicio (--start)",
      "options": [
        "crest",
        "opt",
        "numfreq",
        "sp",
        "tddft",
        "adc2"
      ],
      "default": "crest"
    },
    {
      "id": "watch_step",
      "type": "pickString",
      "description": "Etapa a monitorear (--step, para watch manual)",
      "options": [
        "auto",
        "crest",
        "censo",
        "opt",
        "numfreq",
        "sp",
        "tddft",
        "adc2"
      ],
      "default": "auto"
    }
  ],
  "tasks": [
    {
      "label": "FAE: Run pipeline",
      "type": "shell",
      "command": "conda run -n sciencebitch python pipeline.py --mol ${input:mol_file} --charge ${input:charge}",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "CREST → CENSO → OPT → NumFreq → SP → TD-DFT → ADC2"
    },
    {
      "label": "FAE: Run pipeline (desde etapa)",
      "type": "shell",
      "command": "conda run -n sciencebitch python pipeline.py --mol ${input:mol_file} --charge ${input:charge} --start ${input:start_step}",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Retoma el pipeline desde la etapa elegida"
    },
    {
      "label": "FAE: Watch pipeline (auto)",
      "type": "shell",
      "command": "bash watch_pipeline.sh ${input:mol_name}",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": [],
      "detail": "tail -f automático: cambia de archivo al detectar nueva etapa"
    },
    {
      "label": "FAE: Watch step (manual)",
      "type": "shell",
      "command": "bash watch_pipeline.sh ${input:mol_name} --step ${input:watch_step}",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": [],
      "detail": "tail -f de una etapa concreta (opt, numfreq, sp, etc.)"
    },
    {
      "label": "FAE: Status",
      "type": "shell",
      "command": "conda run -n sciencebitch python pipeline.py --status",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Muestra estado de todos los runs en runs/"
    },
    {
      "label": "FAE: Watch pipeline.log",
      "type": "shell",
      "command": "tail -f runs/${input:mol_name}/pipeline.log",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Log maestro del pipeline (timestamps + etapas)"
    },
    {
      "label": "FAE: Collect results",
      "type": "shell",
      "command": "conda run -n sciencebitch python results_collector.py --mol ${input:mol_name}",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Corre results_collector.py sobre el mol especificado"
    },
    {
      "label": "FAE: Run + Watch",
      "dependsOn": [
        "FAE: Run pipeline",
        "FAE: Watch pipeline (auto)"
      ],
      "dependsOrder": "parallel",
      "group": "build",
      "detail": "Lanza pipeline y monitor simultáneamente en dos terminales"
    }
  ]
}