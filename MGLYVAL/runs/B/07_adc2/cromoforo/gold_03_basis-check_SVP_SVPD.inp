! bt-PNO-EOM-CCSD def2-SVP AutoAux TightSCF TightPNO

%pal
  nprocs 4
end

%maxcore 3000

%scf
  MaxIter 300
end

%mdci
  NRoots 3
  MaxIter 200
  DTol 1e-6
  DLPNOLINEAR true
  NEWDOMAINS true
end

* xyzfile 0 1 cromoforo_S1.xyz

$new_job

